{
  "manifest_version": 3,
  "name": "GitLab RST Enhanced",
  "version": "1.0.4",
  "description": "Full reStructuredText rendering and styling in the GitLab UI (self-managed and GitLab.com).",
  "browser_specific_settings": {
    "gecko": {
      "id": "gitlab-rst-enhanced@tiagogreeve"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["styles.css"], "matches": ["<all_urls>"] }
  ],
  "action": {
    "default_title": "GitLab RST Enhanced - click for settings",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    },
    "default_popup": "popup.html"
  },
  "browser_action": {
    "default_title": "GitLab RST Enhanced - click for settings",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  }
}
